# Traible Product Repository - Git Ignore

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Temporary Files
*.tmp
*.temp
.cache/

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependencies (should be in branch-specific .gitignore)
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd

# Build outputs (should be in branch-specific .gitignore)
dist/
build/
*.egg-info/

# Database files (should be in branch-specific .gitignore)
*.sqlite3
*.db

# Coverage reports
coverage/
.coverage
.nyc_output

# Documentation build
docs/_build/

# Backup files
*.bak
*.backup

# Package files
*.tgz
*.tar.gz
*.zip
